{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BDC2026 Handoff V2",
  "type": "object",
  "required": ["schema_version", "loop_id", "from", "to", "summary", "inputs", "outputs", "verification", "limitations", "next_action", "evidence", "created_at"],
  "properties": {
    "schema_version": {"const": "2"},
    "loop_id": {"type": "string", "pattern": "^loop-[0-9]{3,}$"},
    "from": {"type": ["string", "null"]},
    "to": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "verification": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string"}
  },
  "additionalProperties": false
}
