{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BDC2026 Experiment Decision V2",
  "type": "object",
  "required": ["schema_version", "id", "loop_id", "decision", "reason", "evidence", "created_at"],
  "properties": {
    "schema_version": {"const": "2"},
    "id": {"type": "string"},
    "loop_id": {"type": "string"},
    "decision": {"enum": ["accept", "reject", "hold"]},
    "reason": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string"}
  },
  "additionalProperties": false
}
